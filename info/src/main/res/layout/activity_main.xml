<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#090D1A" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="10dp" android:paddingBottom="8dp" android:layoutDirection="rtl">
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false" android:scrollbars="vertical" android:overScrollMode="ifContentScrolls">
        <LinearLayout android:id="@+id/content" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layoutDirection="rtl" android:paddingBottom="14dp"/>
    </ScrollView>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#202940"/>
    <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#4BCDD9" android:textSize="12sp" android:gravity="right|center_vertical" android:paddingTop="9dp" android:paddingBottom="3dp" android:fontFamily="sans-serif-medium"/>
</LinearLayout>